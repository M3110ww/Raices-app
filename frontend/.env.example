# URL de la API Java. Si se deja vacía o sin definir, todo se calcula en el
# navegador con el mismo algoritmo, y el selector de motor queda en "Navegador".
#
# Desarrollo local (backend levantado con ./mvnw spring-boot:run):
# VITE_API_URL=http://localhost:8080
#
# Producción: la URL que da Render al desplegar el backend.
# VITE_API_URL=https://raices-api.onrender.com
